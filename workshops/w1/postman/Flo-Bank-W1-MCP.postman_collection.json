          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const raw = pm.response.text();",
                  "let message;",
                  "try { message = JSON.parse(raw); } catch (e) {",
                  "  for (const line of raw.split(/\\r?\\n/)) {",
                  "    if (line.startsWith(\"data:\")) {",
                  "      try { message = JSON.parse(line.slice(5).trim()); break; } catch (ignored) {}",
                  "    }",
                  "  }",
                  "}",
                  "if (message) console.log(\"Parsed MCP response\", message);",
                  "if (message && message.result) console.log(\"Curated tools\", message.result.tools);"
                ]
              }
            }
          ]
        },
