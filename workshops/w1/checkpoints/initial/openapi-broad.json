          "name",
          "balance",
          "currency",
          "status"
        ],
        "title": "AccountResponse"
      },
      "ApprovalActionRequest": {
        "properties": {
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "title": "ApprovalActionRequest"
      },
      "ApprovalActionResponse": {
        "properties": {
          "proposal_id": {
            "type": "string",
            "title": "Proposal Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "approver_id": {
            "type": "string",
            "title": "Approver Id"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "proposal_id",
          "status",
          "approver_id",
          "message"
        ],
        "title": "ApprovalActionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "database": {
            "type": "string",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "database"
        ],
        "title": "HealthResponse"
      },
      "IncidentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "service_name": {
            "type": "string",
            "title": "Service Name"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "root_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Root Cause"
          },
          "remediation_action": {
            "type": "string",
            "title": "Remediation Action"
          }
        },
        "type": "object",
        "required": [
          "id",
          "service_name",
          "severity",
          "status",
          "remediation_action"
        ],
        "title": "IncidentResponse"
      },
      "PaymentExecuteRequest": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "amount": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "INR"
          },
          "beneficiary": {
            "type": "string",
            "title": "Beneficiary"
          },
          "proposal_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proposal Id",
            "description": "Required if amount exceeds unsupervised policy limit"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "amount",
          "beneficiary"
        ],
        "title": "PaymentExecuteRequest"
