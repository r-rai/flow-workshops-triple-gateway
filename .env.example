# ==============================================================================
# Flo Bank Triple-Gateway Workshop Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed.
# DO NOT commit real secrets or production keys to version control.
# ==============================================================================

# Project & Profiles
COMPOSE_PROJECT_NAME=novabank-workshops
ACTIVE_PROFILE=w1

# Gateway Ports (Host bindings)
# Default is 9080 for HTTP. Ensure these ports do not conflict with existing services (e.g. Caddy on 80/443).
APISIX_HTTP_PORT=9080
# Standalone customer dashboard/chat demo (optional; defaults to 8000)
DEMO_HTTP_PORT=8000
JAEGER_UI_PORT=16686
KEYCLOAK_PORT=8082

# Internal Security Secrets & Keys (Pre-configured for local workshop labs)
GATE3_API_KEY=gate3-secret-token
JWT_SECRET_KEY=novabank-super-secret-signing-key-for-lab
JWT_ALGORITHM=HS256
JWT_ISSUER=https://identity.novabank.internal/realms/novabank
API_AUDIENCE=novabank-api
MCP_AUDIENCE=novabank-mcp

# Database Configuration
# w1 uses SQLite embedded by default; w2-w4 connect to PostgreSQL
DATABASE_URL=sqlite:////app/data/novabank.sqlite
POSTGRES_USER=novabank
POSTGRES_PASSWORD=novabank-db-pass
POSTGRES_DB=novabank

# Telemetry & Observability
ENABLE_TELEMETRY=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# Model Provider / Replay Settings
USE_REPLAY_FIXTURES=true
OPENAI_API_KEY=mock-key-not-used-in-replay
ANTHROPIC_API_KEY=mock-key-not-used-in-replay

# MiniMax Provider Settings (W3 Real Agent Lab)
# Set USE_REPLAY_FIXTURES=false when using a real provider key.
MINIMAX_API_KEY=
LLM_PROVIDER_URL=https://api.minimax.io/v1/chat/completions
LLM_MODEL=MiniMax-M2.7
INFERENCE_BUDGET_TOKENS=100000
