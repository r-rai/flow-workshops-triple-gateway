#!/usr/bin/env bash
# ==============================================================================
# NovaBank Triple-Gateway Workshop Platform Operator Interface
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

STATE_FILE="${REPO_ROOT}/.active_profile"
ENV_FILE="${REPO_ROOT}/.env"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() { echo -e "${BLUE}[INFO]${NC} $*"; }
log_ok()   { echo -e "${GREEN}[OK]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_err()  { echo -e "${RED}[ERROR]${NC} $*"; }

ensure_env() {
    if [[ ! -f "${ENV_FILE}" ]]; then
        if [[ -f "${REPO_ROOT}/.env.example" ]]; then
            log_warn ".env not found. Creating from .env.example..."
            cp "${REPO_ROOT}/.env.example" "${ENV_FILE}"
        else
            log_err "Missing .env and .env.example!"
            exit 1
        fi
    fi
}

get_active_profile() {
    if [[ -f "${STATE_FILE}" ]]; then
        cat "${STATE_FILE}"
    else
        echo "none"
    fi
}

set_active_profile() {
    local profile="$1"
    echo "${profile}" > "${STATE_FILE}"
    # Update ACTIVE_PROFILE in .env
    sed -i "s/^ACTIVE_PROFILE=.*/ACTIVE_PROFILE=${profile}/" "${ENV_FILE}" || echo "ACTIVE_PROFILE=${profile}" >> "${ENV_FILE}"
}

cmd_preflight() {
    echo "====================================================================="
    echo " NovaBank Workshop Platform: System Preflight Check"
    echo "====================================================================="
    local failed=0

    # 1. Dependency checks
    echo -n "Checking docker... "
    if command -v docker >/dev/null 2>&1; then
        echo -e "${GREEN}$(docker --version)${NC}"
    else
        echo -e "${RED}NOT FOUND${NC}"; failed=1
    fi

    echo -n "Checking docker compose... "
    if docker compose version >/dev/null 2>&1; then
        echo -e "${GREEN}$(docker compose version)${NC}"
    else
        echo -e "${RED}NOT FOUND${NC}"; failed=1
    fi

    echo -n "Checking python3... "
    if command -v python3 >/dev/null 2>&1; then
        echo -e "${GREEN}$(python3 --version)${NC}"
    else
        echo -e "${RED}NOT FOUND${NC}"; failed=1
    fi

    # 2. Host Memory Budget (Ensure 6 GB budget)
    echo -n "Checking host memory... "
    local avail_mem
    avail_mem=$(free -m | awk '/^Mem:/{print $7}')
    if [[ "${avail_mem}" -ge 2000 ]]; then
        echo -e "${GREEN}${avail_mem} MiB available (budget >= 2000 MiB satisfied)${NC}"
    else
        echo -e "${YELLOW}${avail_mem} MiB available (tight memory headroom)${NC}"
    fi

    # 3. Disk Space
    echo -n "Checking root disk space... "
    local free_disk
    free_disk=$(df -h / | awk 'NR==2 {print $4}')
    echo -e "${GREEN}${free_disk} free${NC}"

    # 4. Port Availability (9080)
    echo -n "Checking APISIX port 9080... "
    if ss -ltn | grep -q ":9080 "; then
        local active_prof
        active_prof=$(get_active_profile)
        if [[ "${active_prof}" != "none" ]]; then
            echo -e "${YELLOW}Port 9080 currently occupied by active profile '${active_prof}'${NC}"
        else
            echo -e "${RED}Port 9080 is already in use by an external process!${NC}"
            failed=1
        fi
    else
        echo -e "${GREEN}Port 9080 is available${NC}"
    fi

    # 5. Manifest & Images
    echo -n "Checking release manifest and image digests... "
    local digest_out
    if digest_out=$(python3 -c '
import json, os, subprocess, sys

manifest_path = os.environ.get("WORKSHOP_MANIFEST_PATH", "config/manifest.json")
try:
    with open(manifest_path, "r") as f:
        manifest = json.load(f)
except Exception as e:
    print(f"Failed to read or parse {manifest_path}: {e}")
    sys.exit(1)

pinned = manifest.get("pinned_images")
if not pinned or not isinstance(pinned, dict):
    print("Manifest contains no pinned_images mapping")
    sys.exit(1)

errors = []
verified_count = 0
for svc, details in pinned.items():
    if not isinstance(details, dict):
        errors.append(f"{svc}: invalid details in manifest")
        continue
    expected_digest = details.get("digest")
    img_name = details.get("image")
    if not img_name or not expected_digest:
        errors.append(f"{svc}: missing image name or expected digest in manifest")
        continue

    res = subprocess.run(
        ["docker", "image", "inspect", img_name, "--format", "{{json .RepoDigests}}"],
        capture_output=True,
        text=True
    )
    if res.returncode != 0:
        err_msg = res.stderr.strip() or f"exit code {res.returncode}"
        errors.append(f"{svc}: inspection failed for {img_name} ({err_msg})")
        continue

    raw_digests = res.stdout.strip()
    try:
        repo_digests = json.loads(raw_digests) if raw_digests else []
    except Exception:
        repo_digests = [raw_digests]

    if not repo_digests or not any(expected_digest in rd for rd in repo_digests):
        errors.append(f"{svc}: digest mismatch for {img_name} (expected {expected_digest}, found {repo_digests})")
        continue

    verified_count += 1

if errors:
    print("Digest verification failed:\n  - " + "\n  - ".join(errors))
    sys.exit(1)

print(f"All {verified_count} pinned digests verified against {manifest_path}")
' 2>&1); then
        echo -e "${GREEN}${digest_out}${NC}"
    else
        echo -e "${RED}${digest_out}${NC}"
        failed=1
    fi

    # 6. Preserving Caddy & Existing Services
    echo -n "Checking existing Caddy & monitoring services... "
    local existing_services
    existing_services=$(docker ps --format '{{.Names}}' | grep -E 'caddy|uptime-kuma|portainer|dozzle' || true)
    if [[ -n "${existing_services}" ]]; then
        echo -e "${GREEN}Protected services detected: ${existing_services//$'\n'/, }${NC}"
    else
        echo -e "${YELLOW}No existing Caddy/monitoring containers found${NC}"
    fi

    echo "====================================================================="
    if [[ "${failed}" -eq 0 ]]; then
        log_ok "Preflight PASSED! Host is ready for workshop execution."
        return 0
    else
        log_err "Preflight FAILED! Resolve the above issues before continuing."
        return 1
    fi
}

cmd_pull() {
    local profile="${1:-}"
    if [[ -z "${profile}" ]]; then
        log_err "Usage: $0 pull <w1|w2|w3|w4>"
        exit 1
    fi
    ensure_env

    log_info "Fetching pinned images and building components for profile '${profile}'..."
    export ACTIVE_PROFILE="${profile}"
    docker compose --profile "${profile}" build
    docker compose --profile "${profile}" pull --ignore-buildable
    log_ok "Images for profile '${profile}' are ready."
}

cmd_start() {
    local profile="${1:-}"
    if [[ -z "${profile}" ]]; then
        log_err "Usage: $0 start <w1|w2|w3|w4>"
        exit 1
    fi
    ensure_env

    local current
    current=$(get_active_profile)
    if [[ "${current}" != "none" && "${current}" != "${profile}" ]]; then
        log_err "Profile '${current}' is already running! Refusing to start conflicting profile '${profile}'."
        log_warn "Use '$0 switch ${profile}' to switch profiles safely."
        exit 1
    fi

    log_info "Starting workshop profile '${profile}' within 6 GB operating budget..."
    export ACTIVE_PROFILE="${profile}"
    set_active_profile "${profile}"

    docker compose --profile "${profile}" up -d

    log_info "Waiting for backend API and spec readiness..."
    local backend_ready=0
    for i in {1..35}; do
        if curl -s -f "http://127.0.0.1:9080/api/v1/accounts/acc-101" -H "X-API-Key: gate3-secret-token" >/dev/null 2>&1 && \
           docker compose exec -T api python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/openapi.json')" >/dev/null 2>&1; then
            if [[ "${profile}" == "w1" ]]; then
                if docker compose exec -T api python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/openapi-curated.json')" >/dev/null 2>&1; then
                    backend_ready=1
                    break
                fi
            else
                backend_ready=1
                break
            fi
        fi
        sleep 1
    done

    if [[ "${backend_ready}" -ne 1 ]]; then
        log_err "Backend API/spec readiness timed out. Inspect status via '$0 status'."
        exit 1
    fi

    # Brief delay to ensure APISIX upstream cache readiness
    sleep 1

    log_info "Warming up MCP gateway and downstream tools..."
    local tool_name="get_account"
    local tool_args='{"id": "acc-101"}'
    if [[ "${profile}" == "w1" ]]; then
        tool_name="read_account_api_v1_accounts__id__get"
        tool_args='{"pathParameters": {"id": "acc-101"}}'
    fi

    local mcp_ready=0
    for i in {1..15}; do
        local init_res
        init_res=$(curl -s -f "http://127.0.0.1:9080/mcp" -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
           -d '{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2024-11-05", "capabilities": {}, "clientInfo": {"name": "startup-warm", "version": "1.0"}}}' 2>/dev/null || true)

        local list_res
        list_res=$(curl -s -f "http://127.0.0.1:9080/mcp" -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
           -d '{"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}}' 2>/dev/null || true)

        local call_res
        call_res=$(curl -s -f "http://127.0.0.1:9080/mcp" -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" -H "X-API-Key: gate3-secret-token" \
           -d "{\"jsonrpc\": \"2.0\", \"id\": 3, \"method\": \"tools/call\", \"params\": {\"name\": \"${tool_name}\", \"arguments\": ${tool_args}}}" 2>/dev/null || true)

        if [[ -n "${init_res}" && "${list_res}" =~ "tools" && ("${call_res}" =~ "balance" || "${call_res}" =~ "INR") ]]; then
            if [[ "${profile}" == "w1" ]]; then
                local cur_init
                cur_init=$(curl -s -f "http://127.0.0.1:9080/mcp/curated" -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" \
                   -d '{"jsonrpc": "2.0", "id": 11, "method": "initialize", "params": {"protocolVersion": "2024-11-05", "capabilities": {}, "clientInfo": {"name": "curated-warm", "version": "1.0"}}}' 2>/dev/null || true)
                local cur_call
                cur_call=$(curl -s -f "http://127.0.0.1:9080/mcp/curated" -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" -H "X-API-Key: gate3-secret-token" \
                   -d '{"jsonrpc": "2.0", "id": 12, "method": "tools/call", "params": {"name": "get_account", "arguments": {"pathParameters": {"id": "acc-101"}}}}' 2>/dev/null || true)
                if [[ -n "${cur_init}" && ("${cur_call}" =~ "balance" || "${cur_call}" =~ "INR") ]]; then
                    mcp_ready=1
                    break
                fi
            else
                mcp_ready=1
                break
            fi
        fi
        sleep 1
    done

    if [[ "${mcp_ready}" -eq 1 ]]; then
        log_ok "Workshop profile '${profile}' is ACTIVE and healthy on http://127.0.0.1:9080"
    else
        log_err "MCP warming failed or timed out. Inspect status via '$0 status'."
        exit 1
    fi
}


cmd_status() {
    ensure_env
    local current
    current=$(get_active_profile)
    echo "====================================================================="
    echo " Active Workshop Profile: ${current}"
    echo "====================================================================="
    docker compose ps
    echo ""
    echo "Memory & Resource Usage:"
    docker stats --no-stream $(docker compose ps -q 2>/dev/null || true) 2>/dev/null || echo "No containers running."
    echo "====================================================================="
}

cmd_verify() {
    local profile="${1:-}"
    if [[ -z "${profile}" ]]; then
        profile=$(get_active_profile)
        if [[ "${profile}" == "none" ]]; then
            log_err "No profile is active. Specify: $0 verify <w1|w2|w3|w4>"
            exit 1
        fi
    fi

    log_info "Executing verification test suite for profile '${profile}'..."
    PYTHONPATH=. .venv/bin/python "tests/test_profile_${profile}.py"
    log_ok "Verification for profile '${profile}' PASSED!"
}

cmd_switch() {
    local target="${1:-}"
    if [[ -z "${target}" ]]; then
        log_err "Usage: $0 switch <w1|w2|w3|w4>"
        exit 1
    fi

    local current
    current=$(get_active_profile)
    log_info "Switching profile: '${current}' -> '${target}'..."

    log_info "Stopping current workshop containers (preserving named volumes)..."
    docker compose --profile w1 --profile w2 --profile w3 --profile w4 down --remove-orphans || true
    echo "none" > "${STATE_FILE}"

    cmd_start "${target}"
    log_ok "Switched to profile '${target}' successfully."
}

cmd_reset() {
    local profile="${1:-}"
    local force="${2:-}"
    if [[ -z "${profile}" ]]; then
        profile=$(get_active_profile)
    fi

    echo "====================================================================="
    echo " CAUTION: Lab State Reset for Profile '${profile}'"
    echo "====================================================================="
    echo "This action will restore the initial seeded accounts, cases, and incidents."
    echo "Existing Caddy, monitoring, and host services will NOT be touched."
    echo "====================================================================="

    if [[ "${force}" != "-y" && "${force}" != "--yes" && "${FORCE:-}" != "true" ]]; then
        read -p "Are you sure you want to reset profile '${profile}' lab state? (y/N): " confirm
        if [[ "${confirm}" != "y" && "${confirm}" != "Y" ]]; then
            log_info "Reset cancelled by operator."
            exit 0
        fi
    fi

    log_info "Resetting database using API admin reset endpoint..."
    local reset_res
    reset_res=$(curl -s -X POST "http://127.0.0.1:9080/api/v1/admin/reset" \
        -H "X-API-Key: gate3-secret-token" \
        -H "X-Confirm-Reset: CONFIRM" || true)

    if echo "${reset_res}" | grep -q '"status":"success"'; then
        log_ok "Lab state reset completed successfully!"
        echo "${reset_res}"
    else
        log_warn "API reset call failed or APISIX not reachable. Falling back to local python reset..."
        PYTHONPATH=. .venv/bin/python -c "from src.core.database import SessionLocal; from src.services.seed import reset_and_seed_db; db=SessionLocal(); print(reset_and_seed_db(db)); db.close()"
        log_ok "Direct database reset succeeded."
    fi
}

cmd_stop() {
    log_info "Stopping Novabank workshop services..."
    docker compose --profile w1 --profile w2 --profile w3 --profile w4 down --remove-orphans
    echo "none" > "${STATE_FILE}"
    log_ok "Novabank workshop services stopped. Persistent data preserved."
}

# Main Command Dispatch
case "${1:-}" in
    preflight)
        cmd_preflight
        ;;
    pull)
        shift; cmd_pull "$@"
        ;;
    start)
        shift; cmd_start "$@"
        ;;
    status)
        cmd_status
        ;;
    verify)
        shift; cmd_verify "$@"
        ;;
    switch)
        shift; cmd_switch "$@"
        ;;
    reset)
        shift; cmd_reset "$@"
        ;;
    stop)
        cmd_stop
        ;;
    *)
        echo "Usage: $0 {preflight|pull PROFILE|start PROFILE|status|verify PROFILE|switch PROFILE|reset PROFILE|stop}"
        exit 1
        ;;
esac
